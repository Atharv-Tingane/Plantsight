# PlantSight Backend Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example local: mongodb://127.0.0.1:27017/plantsight
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/plantsight?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/plantsight

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Google Gemini API Key for AI Plant Analysis
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloudinary Credentials for Plant Image Storage
# Sign up free at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Secret for User Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d
